{
  "outputDirectory": "client/build",
  "rewrites": [
    {
      "source": "/api/ai/agent",
      "destination": "/api/ai/agent.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "unsafe-none"
        }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    },
    "api/ai/agent.js": {
      "maxDuration": 300
    }
  }
}
